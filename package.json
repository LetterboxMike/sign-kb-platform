{
  "name": "sign-kb-serving-surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rebuildable read index (serving surface) over the sign knowledge base. Phase 1: schema + loader (structured filtering).",
  "scripts": {
    "check": "tsx src/check.ts",
    "chunks:preview": "tsx src/chunk-preview.ts",
    "load": "tsx src/loader.ts",
    "load:rebuild": "tsx src/loader.ts --rebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
