# Web app environment. Locally: put the NEXT_PUBLIC_* vars in web/.env.local; the server vars are
# loaded from the repo-root .env by next.config.mjs. On Vercel: set ALL of these as project env vars.

# Browser-facing (Auth login). The publishable/anon key is safe in the client.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-side (data core + storage + extraction/chat). Never exposed to the browser.
DATABASE_URL=postgresql://postgres.<ref>:<pw>@<pooler-host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret>
OPENAI_API_KEY=<openai key>
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
# CHAT_MODEL=gpt-5.4              # optional override (chat + extraction + corrections)

# Cron auth for GET /api/ingest/process (set in prod so the auto-drain cron is protected).
CRON_SECRET=<random secret>
