# Supabase project (SignKB-ServingSurface)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref

# Service-role (secret) key — server-side only, NEVER shipped to the browser. Needed for the
# web app's drawing storage (uploads to the private `drawings` bucket + signed view URLs).
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used by the loader (use the IPv4 Session pooler string).
# Format: postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Embedding model (Phase 2)
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
OPENAI_API_KEY=

# Corpus paths (source of truth — read only)
RECORDS_DIR=./records
REFERENCE_FILE=./reference/manufacturer-reference.json
CANON_DIR=./canon
SCHEMA_PATH=./sign-record.schema.json
